# ===================================================
# Journey Architect — Hostinger Production Environment
# ===================================================

# Standard Hostinger Port
PORT=3000
NODE_ENV=production

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password

# Admin Portal URL (Production Domain)
ADMIN_URL=https://journeyarchitect.co.in/admin

# Email Notifications & SMTP Configuration
# Option A: Hostinger Professional Email (Recommended)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@journeyarchitect.co.in
SMTP_PASS=your_hostinger_mailbox_password
FROM_NAME=Journey Architect Bookings
FROM_EMAIL=contact@journeyarchitect.co.in
BOOKING_NOTIFICATION_EMAIL=contact@journeyarchitect.co.in

# Option B: Gmail SMTP (Alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=sudiptajourneys@gmail.com
# SMTP_PASS=your_16_digit_gmail_app_password

# Google Profile & Review URL
GOOGLE_REVIEW_URL=https://share.google/sivygyIsAaYgFkLu1
